# Copy to .env and fill in. .env is gitignored.

# Where the SQLite DB and booking artifacts are stored.
BB_DATA_DIR=./data

# Session signing / app secret (change in production).
BB_SECRET_KEY=change-me

# Host port to publish (docker-compose.yml only; container always listens on
# 8000 internally).
BB_PORT=8000

# Shared login gate (Basic Auth on the whole app) for hosted deployments.
# Leave both blank to disable (fine for pure-local use only) -- required for
# anything reachable from outside your own machine.
BB_AUTH_USER=
BB_AUTH_PASS=

# Portal base URL (rarely changes).
BB_BASE_URL=https://aranyavihaara.karnataka.gov.in

# Optional OCR.space API key for captcha fallback ("helloworld" is the free demo key).
BB_OCR_SPACE_KEY=helloworld

# Optional: enables AI smart-paste parsing of trekker text via Claude.
# Leave unset to use the offline heuristic parser only.
ANTHROPIC_API_KEY=
