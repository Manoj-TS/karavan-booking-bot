# Copy to .env and fill in. .env is gitignored.

# Where the SQLite DB and booking artifacts are stored.
BB_DATA_DIR=./data

# Session signing / app secret (change in production).
BB_SECRET_KEY=change-me

# Portal base URL (rarely changes).
BB_BASE_URL=https://aranyavihaara.karnataka.gov.in

# Optional OCR.space API key for captcha fallback ("helloworld" is the free demo key).
BB_OCR_SPACE_KEY=helloworld
